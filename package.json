    "prisma:seed": "node prisma/seeds/index.js",
    "prisma:studio": "prisma studio",
    "swagger": "node src/config/swagger.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "keywords": [
    "nutrition",
    "fitness",
    "health",
