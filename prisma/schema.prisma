generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid()) @db.Char(36)
  firstName            String               @map("first_name") @db.VarChar(100)
  lastName             String?              @map("last_name") @db.VarChar(100)
  email                String               @unique(map: "email") @db.VarChar(255)
  phoneCode            String?              @map("phone_code") @db.VarChar(10)
  phoneNumber          String?              @unique(map: "phone_number") @map("phone_number") @db.VarChar(20)
  passwordHash         String?              @map("password_hash") @db.VarChar(255)
  authProvider         String?              @default("local") @map("auth_provider") @db.VarChar(50)
  providerId           String?              @map("provider_id") @db.VarChar(255)
  isEmailVerified      Boolean?             @default(false) @map("is_email_verified")
  isPhoneVerified      Boolean?             @default(false) @map("is_phone_verified")
  twoFactorEnabled     Boolean?             @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?              @map("two_factor_secret") @db.VarChar(255)
  status               String?              @default("ACTIVE") @db.VarChar(50)
  lastLoginAt          DateTime?            @map("last_login_at") @db.Timestamp(0)
  createdAt            DateTime?            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt            DateTime?            @default(now()) @map("updated_at") @db.Timestamp(0)
  deletedAt            DateTime?            @map("deleted_at") @db.Timestamp(0)
  aiPredictionLogs     AiPredictionLog[]
  auditLogs            AuditLog[]
  authOtps             AuthOtp[]
  authRefreshTokens    AuthRefreshToken[]
  authSessions         AuthSession[]
  blogs                Blog[]
  bodyMeasurements     BodyMeasurement[]
  emergencyContacts    EmergencyContact[]
  exerciseLogs         ExerciseLog[]
  exercises            Exercise[]
  familyGroups         FamilyGroup[]
  familyMembers        FamilyMember[]
  fitnessProfile       FitnessProfile?
  foods                Food[]
  healthProfile        HealthProfile?
  invoices             Invoice[]
  loginHistory         LoginHistory[]
  mealPlans            MealPlan[]
  mealTemplates        MealTemplate[]
  meals                Meal[]
  media                Media[]
  notificationSettings NotificationSetting?
  notifications        Notification[]
  organizationRoles    OrganizationRole[]
  privacySettings      PrivacySetting?
  profile              Profile?
  progressPhotos       ProgressPhoto[]
  recentSearches       RecentSearch[]
  recipes              Recipe[]
  referralHistory      ReferralHistory?
  referral             Referral?
  subscriptions        Subscription[]
  teamMembers          TeamMember[]
  userFavoriteFoods    UserFavoriteFood[]
  userPreferences      UserPreference?
  userRoles            UserRole[]
  wallet               Wallet?
  weightLogs           WeightLog[]
  workoutPlans         WorkoutPlan[]

  @@index([email, status], map: "idx_users_email_status")
  @@map("users")
}

model Profile {
  id           String    @id @default(cuid()) @db.Char(36)
  userId       String    @unique(map: "user_id") @map("user_id") @db.Char(36)
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  gender       String?   @db.VarChar(50)
  bio          String?   @db.Text
  addressLine1 String?   @map("address_line1") @db.VarChar(255)
  addressLine2 String?   @map("address_line2") @db.VarChar(255)
  city         String?   @db.VarChar(100)
  state        String?   @db.VarChar(100)
  country      String?   @db.VarChar(100)
  zipCode      String?   @map("zip_code") @db.VarChar(20)
  languages    Json?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamp(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profiles_user")

  @@map("profiles")
}

model FoodCategory {
  id        String         @id @default(cuid()) @db.Char(36)
  name      String         @db.VarChar(255)
  slug      String         @unique(map: "slug") @db.VarChar(255)
  parentId  String?        @map("parent_id") @db.Char(36)
  iconUrl   String?        @map("icon_url") @db.VarChar(1000)
  createdAt DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime?      @default(now()) @map("updated_at") @db.Timestamp(0)
  parent    FoodCategory?  @relation("food_categoriesTofood_categories", fields: [parentId], references: [id], onUpdate: NoAction, map: "fk_food_cat_parent")
  children  FoodCategory[] @relation("food_categoriesTofood_categories")
  foods     Food[]

  @@index([parentId], map: "fk_food_cat_parent")
  @@map("food_categories")
}

model Food {
  id                String             @id @default(cuid()) @db.Char(36)
  organizationId    String?            @map("organization_id") @db.Char(36)
  userId            String?            @map("user_id") @db.Char(36)
  categoryId        String?            @map("category_id") @db.Char(36)
  name              String             @db.VarChar(255)
  brandName         String?            @map("brand_name") @db.VarChar(255)
  foodType          String?            @default("GENERIC") @map("food_type") @db.VarChar(50)
  isVerified        Boolean?           @default(false) @map("is_verified")
  currentVersion    Int                @default(1) @map("current_version")
  imageUrl          String?            @map("image_url") @db.VarChar(1000)
  servingSize       Decimal            @map("serving_size") @db.Decimal(8, 2)
  servingUnit       String             @map("serving_unit") @db.VarChar(50)
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime?          @default(now()) @map("updated_at") @db.Timestamp(0)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamp(0)
  createdBy         String?            @map("created_by") @db.Char(36)
  updatedBy         String?            @map("updated_by") @db.Char(36)
  barcodes          Barcode[]
  foodSynonyms      FoodSynonym[]
  foodTranslations  FoodTranslation[]
  foodVersions      FoodVersion[]
  category          FoodCategory?      @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "fk_foods_cat")
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_foods_org")
  user              User?              @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "fk_foods_user")
  recentSearches    RecentSearch[]
  userFavoriteFoods UserFavoriteFood[]

  @@index([categoryId], map: "fk_foods_cat")
  @@index([organizationId], map: "fk_foods_org")
  @@index([userId], map: "fk_foods_user")
  @@index([name, brandName], map: "ft_foods_name")
  @@map("foods")
}

model Meal {
  id            String     @id @default(cuid()) @db.Char(36)
  userId        String     @map("user_id") @db.Char(36)
  mealType      String     @map("meal_type") @db.VarChar(50)
  mealDate      DateTime   @map("meal_date") @db.Date
  notes         String?    @db.Text
  imageUrl      String?    @map("image_url") @db.VarChar(1000)
  totalCalories Decimal?   @default(0.00) @map("total_calories") @db.Decimal(8, 2)
  totalProtein  Decimal?   @default(0.00) @map("total_protein") @db.Decimal(8, 2)
  totalCarbs    Decimal?   @default(0.00) @map("total_carbs") @db.Decimal(8, 2)
  totalFat      Decimal?   @default(0.00) @map("total_fat") @db.Decimal(8, 2)
  createdAt     DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?  @default(now()) @map("updated_at") @db.Timestamp(0)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamp(0)
  mealItems     MealItem[]
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_meals_user")

  @@index([userId, mealDate], map: "idx_meals_user_date")
  @@map("meals")
}

model MealItem {
  id              String         @id @default(cuid()) @db.Char(36)
  mealId          String         @map("meal_id") @db.Char(36)
  foodVersionId   String?        @map("food_version_id") @db.Char(36)
  recipeVersionId String?        @map("recipe_version_id") @db.Char(36)
  quantity        Decimal        @db.Decimal(8, 2)
  unit            String         @db.VarChar(50)
  calories        Decimal        @db.Decimal(8, 2)
  protein         Decimal        @db.Decimal(8, 2)
  carbs           Decimal        @db.Decimal(8, 2)
  fat             Decimal        @db.Decimal(8, 2)
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?      @default(now()) @map("updated_at") @db.Timestamp(0)
  foodVersion     FoodVersion?   @relation(fields: [foodVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mi_food_version")
  meal            Meal           @relation(fields: [mealId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mi_meal")
  recipeVersion   RecipeVersion? @relation(fields: [recipeVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mi_recipe_version")

  @@index([foodVersionId], map: "fk_mi_food_version")
  @@index([recipeVersionId], map: "fk_mi_recipe_version")
  @@index([mealId], map: "idx_meal_items_meal_id")
  @@map("meal_items")
}

model Exercise {
  id                String            @id @default(cuid()) @db.Char(36)
  organizationId    String?           @map("organization_id") @db.Char(36)
  userId            String?           @map("user_id") @db.Char(36)
  categoryId        String?           @map("category_id") @db.Char(36)
  name              String            @db.VarChar(255)
  description       String?           @db.Text
  videoUrl          String?           @map("video_url") @db.VarChar(1000)
  imageUrl          String?           @map("image_url") @db.VarChar(1000)
  targetMuscleGroup String?           @map("target_muscle_group") @db.VarChar(100)
  equipmentNeeded   String?           @map("equipment_needed") @db.VarChar(100)
  trackingType      String?           @default("REPS_WEIGHT") @map("tracking_type") @db.VarChar(50)
  isVerified        Boolean?          @default(false) @map("is_verified")
  createdAt         DateTime?         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime?         @default(now()) @map("updated_at") @db.Timestamp(0)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamp(0)
  exerciseLogs      ExerciseLog[]
  category          ExerciseCategory? @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "fk_exercises_cat")
  organization      Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_exercises_org")
  user              User?             @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "fk_exercises_user")
  workoutExercises  WorkoutExercise[]

  @@index([categoryId], map: "fk_exercises_cat")
  @@index([organizationId], map: "fk_exercises_org")
  @@index([userId], map: "fk_exercises_user")
  @@fulltext([name, description], map: "ft_exercises_name_desc")
  @@map("exercises")
}

model ExerciseLog {
  id              String    @id @default(cuid()) @db.Char(36)
  userId          String    @map("user_id") @db.Char(36)
  exerciseId      String    @map("exercise_id") @db.Char(36)
  logDate         DateTime  @map("log_date") @db.Date
  sets            Int?
  reps            Int?
  weightKg        Decimal?  @map("weight_kg") @db.Decimal(8, 2)
  durationSeconds Int?      @map("duration_seconds")
  distanceKm      Decimal?  @map("distance_km") @db.Decimal(8, 2)
  caloriesBurned  Decimal?  @map("calories_burned") @db.Decimal(8, 2)
  notes           String?   @db.Text
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @default(now()) @map("updated_at") @db.Timestamp(0)
  exercise        Exercise  @relation(fields: [exerciseId], references: [id], onUpdate: NoAction, map: "fk_el_exercise")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_el_user")

  @@index([exerciseId], map: "fk_el_exercise")
  @@index([userId, logDate], map: "idx_exercise_logs_user_date")
  @@map("exercise_logs")
}

model WeightLog {
  id        String    @id @default(cuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  weightKg  Decimal   @map("weight_kg") @db.Decimal(5, 2)
  logDate   DateTime  @map("log_date") @db.Date
  source    String?   @default("MANUAL") @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_wl_user")

  @@unique([userId, logDate], map: "uq_wl_date")
  @@index([userId, logDate], map: "idx_weight_logs_user_date")
  @@map("weight_logs")
}

model ProgressPhoto {
  id        String    @id @default(cuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  photoUrl  String    @map("photo_url") @db.VarChar(1000)
  photoType String?   @default("FRONT") @map("photo_type") @db.VarChar(50)
  logDate   DateTime  @map("log_date") @db.Date
  weightKg  Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  notes     String?   @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pp_user")

  @@index([userId], map: "fk_pp_user")
  @@map("progress_photos")
}

model Notification {
  id        String    @id @default(cuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  type      String    @db.VarChar(50)
  status    String?   @default("UNREAD") @db.VarChar(50)
  actionUrl String?   @map("action_url") @db.VarChar(1000)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notif_user")

  @@index([userId], map: "fk_notif_user")
  @@map("notifications")
}

model Subscription {
  id                     String        @id @default(cuid()) @db.Char(36)
  userId                 String        @map("user_id") @db.Char(36)
  organizationId         String?       @map("organization_id") @db.Char(36)
  planId                 String        @map("plan_id") @db.Char(36)
  status                 String?       @default("ACTIVE") @db.VarChar(50)
  startDate              DateTime      @default(now()) @map("start_date") @db.Timestamp(0)
  endDate                DateTime?     @map("end_date") @db.Timestamp(0)
  trialEndDate           DateTime?     @map("trial_end_date") @db.Timestamp(0)
  stripeSubscriptionId   String?       @map("stripe_subscription_id") @db.VarChar(255)
  razorpaySubscriptionId String?       @map("razorpay_subscription_id") @db.VarChar(255)
  cancelAtPeriodEnd      Boolean?      @default(false) @map("cancel_at_period_end")
  createdAt              DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt              DateTime?     @default(now()) @map("updated_at") @db.Timestamp(0)
  invoices               Invoice[]
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sub_org")
  plan                   Plan          @relation(fields: [planId], references: [id], onUpdate: NoAction, map: "fk_sub_plan")
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sub_user")

  @@index([organizationId], map: "fk_sub_org")
  @@index([planId], map: "fk_sub_plan")
  @@index([userId, status], map: "idx_subscriptions_user_status")
  @@map("subscriptions")
}

model Payment {
  id                    String    @id @default(cuid()) @db.Char(36)
  invoiceId             String    @map("invoice_id") @db.Char(36)
  amount                Decimal   @db.Decimal(10, 2)
  currency              String?   @default("INR") @db.VarChar(10)
  paymentMethod         String?   @map("payment_method") @db.VarChar(100)
  status                String?   @default("SUCCESS") @db.VarChar(50)
  stripePaymentIntentId String?   @map("stripe_payment_intent_id") @db.VarChar(255)
  razorpayPaymentId     String?   @map("razorpay_payment_id") @db.VarChar(255)
  errorMessage          String?   @map("error_message") @db.Text
  paidAt                DateTime? @default(now()) @map("paid_at") @db.Timestamp(0)
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime? @default(now()) @map("updated_at") @db.Timestamp(0)
  invoice               Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payment_invoice")
  refunds               Refund[]

  @@index([invoiceId], map: "fk_payment_invoice")
  @@map("payments")
}

model Blog {
  id               String            @id @default(cuid()) @db.Char(36)
  organizationId   String?           @map("organization_id") @db.Char(36)
  authorId         String?           @map("author_id") @db.Char(36)
  title            String            @db.VarChar(500)
  slug             String            @unique(map: "slug") @db.VarChar(500)
  content          String            @db.Text
  featuredImageUrl String?           @map("featured_image_url") @db.VarChar(1000)
  status           String?           @default("DRAFT") @db.VarChar(50)
  publishedAt      DateTime?         @map("published_at") @db.Timestamp(0)
  createdAt        DateTime?         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime?         @default(now()) @map("updated_at") @db.Timestamp(0)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamp(0)
  blogTags         BlogTag[]
  blogTranslations BlogTranslation[]
  author           User?             @relation(fields: [authorId], references: [id], onUpdate: NoAction, map: "fk_blogs_author")
  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_blogs_org")

  @@index([authorId], map: "fk_blogs_author")
  @@index([organizationId], map: "fk_blogs_org")
  @@fulltext([title, content], map: "ft_blogs_content")
  @@map("blogs")
}

model Recipe {
  id                 String              @id @default(cuid()) @db.Char(36)
  organizationId     String?             @map("organization_id") @db.Char(36)
  userId             String?             @map("user_id") @db.Char(36)
  name               String              @db.VarChar(255)
  description        String?             @db.Text
  imageUrl           String?             @map("image_url") @db.VarChar(1000)
  prepTimeMinutes    Int?                @map("prep_time_minutes")
  cookTimeMinutes    Int?                @map("cook_time_minutes")
  servings           Decimal             @default(1.00) @db.Decimal(8, 2)
  isVerified         Boolean?            @default(false) @map("is_verified")
  currentVersion     Int                 @default(1) @map("current_version")
  createdAt          DateTime?           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime?           @default(now()) @map("updated_at") @db.Timestamp(0)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamp(0)
  createdBy          String?             @map("created_by") @db.Char(36)
  updatedBy          String?             @map("updated_by") @db.Char(36)
  recipeTranslations RecipeTranslation[]
  recipeVersions     RecipeVersion[]
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recipes_org")
  user               User?               @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "fk_recipes_user")

  @@index([organizationId], map: "fk_recipes_org")
  @@index([userId], map: "fk_recipes_user")
  @@fulltext([name, description], map: "ft_recipes_name_desc")
  @@map("recipes")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model AiPredictionLog {
  id              String    @id @db.Char(36)
  userId          String    @map("user_id") @db.Char(36)
  modelName       String    @map("model_name") @db.VarChar(100)
  predictionType  String    @map("prediction_type") @db.VarChar(100)
  inputPrompt     String?   @map("input_prompt") @db.Text
  outputResponse  String    @map("output_response") @db.Text
  inferenceTimeMs Int?      @map("inference_time_ms")
  tokensUsed      Int?      @map("tokens_used")
  userFeedback    String?   @map("user_feedback") @db.VarChar(50)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ai_user")

  @@index([userId, predictionType], map: "idx_ai_prediction_user_type")
  @@map("ai_prediction_logs")
}

model ApiKey {
  id             String       @id @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  name           String       @db.VarChar(255)
  apiKeyHash     String       @unique(map: "api_key_hash") @map("api_key_hash") @db.VarChar(255)
  scopes         Json?
  expiresAt      DateTime?    @map("expires_at") @db.Timestamp(0)
  isActive       Boolean?     @default(true) @map("is_active")
  lastUsedAt     DateTime?    @map("last_used_at") @db.Timestamp(0)
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?    @default(now()) @map("updated_at") @db.Timestamp(0)
  createdBy      String?      @map("created_by") @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_api_keys_org")

  @@index([organizationId], map: "fk_api_keys_org")
  @@index([apiKeyHash], map: "idx_api_keys_lookup")
  @@map("api_keys")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model AuditLog {
  id             String        @id @db.Char(36)
  organizationId String?       @map("organization_id") @db.Char(36)
  actorId        String?       @map("actor_id") @db.Char(36)
  entityType     String        @map("entity_type") @db.VarChar(100)
  entityId       String        @map("entity_id") @db.Char(36)
  action         String        @db.VarChar(100)
  oldValues      Json?         @map("old_values")
  newValues      Json?         @map("new_values")
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamp(0)
  actor          User?         @relation(fields: [actorId], references: [id], onUpdate: NoAction, map: "fk_audit_actor")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_audit_org")

  @@index([actorId], map: "fk_audit_actor")
  @@index([organizationId], map: "fk_audit_org")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model AuthOtp {
  id         String    @id @db.Char(36)
  userId     String?   @map("user_id") @db.Char(36)
  identifier String    @db.VarChar(255)
